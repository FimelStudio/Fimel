{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fimel",
  "compatibility_date": "2026-07-28",
  "keep_vars": true,
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/work-events",
      "/api/work-downloads",
      "/mods/bingo-but-dont-do-it-1.21.11-v1.0.jar",
      "/plugins/minecraft-obj-cubizer/minecraft_obj_cubizer-1.4.0.zip",
      "/plugins/minecraft-explorer/MinecraftExplorer-1.0-win-x64.exe"
    ]
  },
  "r2_buckets": [{ "binding": "PUBLIC", "bucket_name": "fimel-downloads" }],
  "ratelimits": [{ "name": "METRICS_LIMITER", "namespace_id": "11002", "simple": { "limit": 45, "period": 60 } }],
  "triggers": {
    "crons": [
      "17 */8 * * *"
    ]
  }
}
