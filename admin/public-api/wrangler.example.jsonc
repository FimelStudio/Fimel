{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"fimel-statistics",
  "main":"index.ts",
  "compatibility_date":"2026-10-14",
  "workers_dev":false,"preview_urls":false,
  "routes":[{"pattern":"api.studiofimel.com","custom_domain":true}],
  "r2_buckets":[{"binding":"PUBLIC","bucket_name":"fimel-downloads"}],
  // Replace only after approval and D1 creation. This is an undeployed template.
  "d1_databases":[{"binding":"COUNTS","database_name":"fimel-statistics","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "ratelimits":[{"name":"LIMITER","namespace_id":"11001","simple":{"limit":30,"period":60}}],
  "vars":{"SITE_ORIGIN":"https://studiofimel.com"},
  "observability":{"enabled":true,"traces":{"enabled":true,"head_sampling_rate":0.01}}
}
