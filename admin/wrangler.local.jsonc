{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fimel-admin-local-only",
  "main": "worker/local.ts",
  // Installed workerd 1.20261012.1 supports up to this date. Production remains 2026-10-14.
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"dist","binding":"ASSETS","run_worker_first":true,"not_found_handling":"single-page-application"},
  "r2_buckets": [{"binding":"PRIVATE","bucket_name":"admin-local-private","remote":false},{"binding":"PUBLIC","bucket_name":"admin-local-public","remote":false}],
  "vars": {"ADMIN_ORIGIN":"http://127.0.0.1:5174","ACCESS_AUD":"local-test","ACCESS_ISSUER":"https://local.invalid","ADMIN_EMAILS":"local-admin@example.invalid"}
}
