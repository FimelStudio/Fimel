{
  "name": "fimel",
  "private": true,
  "version": "1.0.0",
  "description": "Fimel Studio official website and creative portfolio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && tsc -b && vite build && node scripts/prepare-bingo-download.mjs",
    "check:content": "node scripts/validate-content.mjs && node scripts/validate-assets.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:api": "wrangler dev --config admin/wrangler.local.jsonc --ip 127.0.0.1 --port 8788 --persist-to .artifacts/admin-local",
    "admin:types": "wrangler types admin/worker-configuration.d.ts --config admin/wrangler.jsonc --include-runtime false && wrangler types admin/public-api/worker-configuration.d.ts --config admin/public-api/wrangler.example.jsonc --env-interface StatisticsEnv --include-runtime false",
    "admin:check": "npm run admin:types && tsc -p admin/tsconfig.json",
    "admin:build": "npm run admin:check && vite build --config admin/vite.config.ts && node scripts/admin-assets.mjs",
    "admin:migration": "tsx scripts/admin-migration.ts",
    "admin:seed": "tsx scripts/admin-migration.ts && tsx scripts/admin-seed-local.ts",
    "admin:test": "tsx scripts/admin-migration.ts && tsx --test admin/tests/*.test.ts",
    "admin:test:e2e": "node scripts/admin-upload-fixture.mjs && playwright test --config admin/playwright.config.ts",
    "admin:test:public": "playwright test --config admin/remote-site.config.ts"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.105.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gsap": "^3.15.0",
    "i18next": "^26.0.10",
    "jose": "^6.2.12",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "motion": "^13.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "miniflare": "^5.20261012.0-beta",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wrangler": "^4.151.0"
  }
}
