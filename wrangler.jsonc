{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fimel",
  "compatibility_date": "2026-07-28",
  "keep_vars": true,
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/mods/bingo-but-dont-do-it-1.21.11-v1.0.jar"
    ]
  },
  "triggers": {
    "crons": [
      "17 */8 * * *"
    ]
  }
}
